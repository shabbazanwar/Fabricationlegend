# Postgres connection string.
# Local dev (Docker):
#   docker run --name flaw-db -e POSTGRES_PASSWORD=dev -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:dev@localhost:5432/postgres"
# Neon: use the POOLED connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Canonical site origin, no trailing slash, e.g. https://fabricationlegend.com
# Drives sitemap, robots.txt, canonical tags, JSON-LD and social card URLs.
# On Vercel this falls back to the deployment URL, so set it only for the
# production domain.
NEXT_PUBLIC_SITE_URL=""

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave unset and the site loads no analytics, sets no cookies, and shows no
# consent banner. Set it and analytics load only after the visitor accepts.
NEXT_PUBLIC_GA_ID=""

# Enquiry notifications (optional). Without RESEND_API_KEY the contact form
# still saves to Postgres, it just does not email anyone.
#
# No sending domain is verified, by choice, so Resend delivers only to the
# address the Resend account was created with. That address must therefore be
# the one you want notified. Leave the two below unset: they default to
# CONTACT.email as recipient and Resend's shared onboarding@resend.dev sender.
RESEND_API_KEY=""
CONTACT_NOTIFY_TO=""
CONTACT_NOTIFY_FROM=""
